# Server-side only. NEVER prefix a key with NEXT_PUBLIC_ — that would inline it
# into the browser bundle. Copy this file to .env.local (gitignored) and fill it in.

# Primary provider. Groq's OpenAI-compatible endpoint; no SDK dependency.
# Placeholder only — never commit a real key to this file.
GROQ_API_KEY=your_groq_api_key_here

# Alternative provider. Used only when GROQ_API_KEY is absent.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides
# VERDICT_PROVIDER: force "groq" or "anthropic" instead of auto-detecting by key.
VERDICT_PROVIDER=
# VERDICT_MODEL defaults to llama-3.3-70b-versatile (groq) or claude-opus-5 (anthropic).
VERDICT_MODEL=
VERDICT_EFFORT=low

# Judging-day kill switch: serve committed cached verdicts, no API calls.
VERDICT_DEMO_ONLY=false
